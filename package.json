{
  "name": "com-boombox-projecty",
  "version": "1.0.10",
  "description": "fridaContainer written in TypeScript and JavaScript",
  "private": false,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:esbuild": "npm exec esbuild -- --bundle --format=esm --outdir=dist --watch index.ts",
    "prepare": "npm run build",
    "build": "frida-compile index.ts -o index.js",
    "watch": "frida-compile index.ts -o index.js -w",
    "build:esbuildtest": "npm exec esbuild -- --bundle --format=esm --outdir=../com.rookie.v/api --watch index.ts"

  },
  "dependencies": {
    "frida-il2cpp-bridge": "^0.12.0",
    "frida-java-bridge": "^7.0.4"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.0.0",
    "@types/node": "^18.19.111",
    "esbuild": "^0.25.2",
    "frida-compile": "^19.0.4"
  }
}
