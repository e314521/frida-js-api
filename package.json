{
  "name": "com-phoenix-read",
  "version": "1.0.10",
  "description": "fridaContainer written in TypeScript and JavaScript",
  "private": false,
  "main": "index.ts",
  "scripts": {
    "prepare": [
      "npm run build",
      "tsc"
    ],
    "build": "frida-compile index.ts -o index.js",
    "watch": "frida-compile index.ts -o index.js -w"
  },
  "dependencies": {
    "@types/base64-js": "^1.5.0",
    "@types/frida-gum": "^18.8.2",
    "@types/node": "^14.18.63",
    "frida-compile": "^10.2.5",
    "frida-il2cpp-bridge": "^0.11.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  }
}
